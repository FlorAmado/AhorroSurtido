PUT http://localhost:5100/nodos/6a5e478fe7f8fb5e713df446/approve
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhNWU0NjJmZTdmOGZiNWU3MTNkZjQ0NCIsInJvbCI6Im1pZW1icm8iLCJub2RvSWQiOm51bGwsImlhdCI6MTc4NDU2MzI0NywiZXhwIjoxNzg1MTY4MDQ3fQ.u71Mct9JwxKPgigqeoWdhQfWKXxMLBJy_3P9aQpoork
